# Node modules (never commit this)
node_modules/

# Next.js build output
.next/
out/

# Build output
/build
/dist

# System files
.DS_Store
Thumbs.db

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files (for API keys, etc.)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE-specific
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS specific
.AppleDouble
.LSOverride
._*

# Testing
coverage/

# Next.js cache and build files
.next/cache/
.next/static/
.next/server/
.next/trace
*.pack.gz
*.hot-update.js
*.hot-update.json

# TypeScript build info
*.tsbuildinfo

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

